# Neon pooled connection string — used by the running app.
DATABASE_URL=postgresql://user:password@host/db

# Neon direct (unpooled) connection string — used only for running migrations.
DATABASE_URL_DIRECT=postgresql://user:password@host/db

# Firebase project used to verify ID tokens (firebase-admin, ADC on Cloud Run).
FIREBASE_PROJECT_ID=laanya-prod

# HTTP port the server listens on.
PORT=8080

# Which deployment this process IS — echoed as the X-Laanya-Env response header.
# One of: development | staging | production. Defaults to development.
APP_ENV=development

# Razorpay credentials for POST /v1/payments/*.
# ALL THREE OR NONE — none means payments degrade to 503 payments_disabled (the
# API ships fine without them); a partial set is rejected at boot.
#
# KEY_ID and KEY_SECRET come from Razorpay Dashboard -> Settings -> API Keys.
# Locally use TEST-mode keys (rzp_test_ prefix); an rzp_live_ prefix flips the
# gateway to live mode and charges real cards.
#
# WEBHOOK_SECRET is different in kind: you invent it and paste it into
# Razorpay's webhook config, and it is what proves an inbound "payment
# succeeded" call really came from Razorpay. Do NOT reuse a deployed
# environment's value locally — anyone holding it can forge signed webhooks
# against that environment. Any random string works for local dev; webhooks
# cannot reach localhost anyway, and the /verify route completes checkout
# without them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Maps Platform SERVER key for GET /v1/geocode/reverse.
# MUST be a different key from the mobile app's Android Maps key: web-service
# APIs (Geocoding) cannot use package+SHA-1 restriction. Restrict this one to
# the Geocoding API alone; it lives in Secret Manager and never ships to a
# client. In prod: secret GOOGLE_MAPS_SERVER_KEY in project laanya-prod.
# Optional — absent, the route returns 503 geocoding_disabled and the mobile app
# falls back to its on-device geocoder.
GOOGLE_MAPS_SERVER_KEY=

# Shared secret that gates direct traffic to the public run.app URL. When set,
# every request must carry a matching X-Laanya-Proxy-Auth header or it is
# rejected (404) — only the laanya-shop Cloudflare edge Worker at
# www.laanya.shop/api injects that header, so setting this closes the run.app
# URL to everyone else.
#
# The SAME value must also be set as the edge Worker's `API_PROXY_SECRET`
# secret (`wrangler secret put API_PROXY_SECRET`) — the two are compared on
# every request and must match exactly.
#
# Generate with: openssl rand -hex 32
# Optional — leave empty locally and until clients have migrated off the
# run.app URL; unset means the gate is not registered at all (open, today's
# behavior). In prod: secret laanya-api-proxy-shared-secret.
PROXY_SHARED_SECRET=

# Brevo (Sendinblue) transactional email — sends the error-alert emails from
# src/lib/alerts.ts (a server 500 or a POST /v1/client-errors batch, in
# staging/production only). ALL THREE OR NONE, like Razorpay: none means
# alerting degrades to log-only (every error is still in Cloud Logging, just
# no email); a partial set fails at boot.
BREVO_API_KEY=
ALERT_EMAIL_FROM=hello@adix.ai
ALERT_EMAIL_TO=gsnz86@gmail.com

# GitHub token + repo ("owner/name") the alerter uses to open/reuse
# `auto-fix-candidate` issues per unique error fingerprint. BOTH OR NEITHER —
# absent, alert emails (if Brevo is configured above) are still sent, just
# without a GitHub issue link. Token needs "Issues: write" on the repo.
ALERT_GITHUB_TOKEN=
ALERT_GITHUB_REPO=

# ── Analytics (RudderStack, source `laanya-backend`) ────────────────────────
# BOTH required or server-side analytics is an inert no-op — a supported state,
# which is what lets tests and local development run without an account.
#
# RUDDERSTACK_WRITE_KEY IS A SECRET, unlike the mobile app's. The mobile key is
# public by design (it ships in the APK and can only write events). This one
# authorises `Order Completed` — it can fabricate revenue in the warehouse and
# conversions at Meta and Google Ads. Secret Manager in staging/prod; never
# commit a value here.
#
# One key serves every environment; they are separated downstream by
# `context.app_env`, which every event carries.
RUDDERSTACK_WRITE_KEY=
# e.g. https://<id>.dataplane.rudderstack.com
RUDDERSTACK_DATA_PLANE_URL=
