{
  "name": "tinytales-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed-config": "tsx --env-file-if-exists=.env scripts/seed-config.ts",
    "db:local:bootstrap": "psql -h 127.0.0.1 -p 5433 -U \"$(whoami)\" -d postgres -f scripts/dev/bootstrap-local-db.sql",
    "db:local:sync": "bash scripts/dev/sync-local-db.sh",
    "db:local:verify": "bash scripts/dev/verify-local-sync.sh",
    "db:seed-fulfilment-config": "tsx --env-file-if-exists=.env scripts/seed-fulfilment-config.ts",
    "db:seed-coupons": "tsx --env-file-if-exists=.env scripts/seed-coupons.ts",
    "db:seed-shipping": "tsx --env-file-if-exists=.env scripts/seed-shipping.ts",
    "db:import-pincodes": "tsx --env-file-if-exists=.env scripts/import-pincodes.ts",
    "db:seed-store-nodes": "tsx --env-file-if-exists=.env scripts/seed-store-nodes.ts",
    "shipping:report": "tsx --env-file-if-exists=.env scripts/shipping-cost-report.ts",
    "db:seed-dev-dimensions": "tsx --env-file-if-exists=.env scripts/seed-dev-dimensions.ts",
    "db:live-test-sku": "tsx --env-file-if-exists=.env scripts/seed-live-test-sku.ts",
    "db:custom-figures": "tsx --env-file-if-exists=.env scripts/seed-custom-figures.ts",
    "db:test-previews": "tsx --env-file-if-exists=.env scripts/seed-test-previews.ts",
    "db:reset-previews": "tsx --env-file-if-exists=.env scripts/reset-previews.ts",
    "catalog:sync": "tsx --env-file-if-exists=.env scripts/catalog-sync.ts",
    "catalog:seed": "tsx --env-file-if-exists=.env scripts/seed-catalog.ts",
    "catalog:doctor": "tsx --env-file-if-exists=.env scripts/catalog-doctor.ts",
    "config:doctor": "tsx --env-file-if-exists=.env scripts/config-doctor.ts",
    "catalog:merge-cream-colors": "tsx --env-file-if-exists=.env scripts/merge-cream-colors.ts",
    "catalog:backfill-placeholders": "tsx --env-file-if-exists=.env scripts/backfill-image-placeholders.ts",
    "db:backfill-pincode-coords": "tsx --env-file-if-exists=.env scripts/backfill-pincode-coords.ts",
    "db:backfill-invoices": "tsx --env-file-if-exists=.env scripts/backfill-invoices.ts",
    "db:backfill-gst-dummy-data": "tsx --env-file-if-exists=.env scripts/backfill-gst-dummy-data.ts",
    "db:scrub-legal-pii": "tsx --env-file-if-exists=.env scripts/scrub-legal-pii.ts",
    "db:sync-legal-config": "tsx --env-file-if-exists=.env scripts/sync-legal-config.ts",
    "db:open-shipping-fence": "tsx --env-file-if-exists=.env scripts/open-shipping-state-fence.ts",
    "db:enable-prod-fulfilment-carrier": "tsx --env-file-if-exists=.env scripts/enable-prod-fulfilment-carrier.ts",
    "delhivery:sync-serviceability": "tsx --env-file-if-exists=.env scripts/sync-delhivery-serviceability.ts",
    "delhivery:sync-rates": "tsx --env-file-if-exists=.env scripts/sync-delhivery-rates.ts",
    "prepare": "husky",
    "ads:export-audience": "tsx --env-file-if-exists=.env scripts/export-ad-audience.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@rudderstack/rudder-sdk-node": "^3.0.12",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "firebase-admin": "13.10.0",
    "google-auth-library": "^10.9.0",
    "pg": "8.22.0",
    "razorpay": "^2.9.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "husky": "^9.1.7",
    "prettier": "3.8.1",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "3.2.7"
  }
}
